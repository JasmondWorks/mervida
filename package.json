    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@upstash/qstash": "^2.12.1",
    "cloudinary": "^2.11.0",
    "next": "16.1.6",
    "react": "19.2.3",
